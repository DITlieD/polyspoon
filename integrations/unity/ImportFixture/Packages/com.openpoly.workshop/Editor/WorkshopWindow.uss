.workshop {
    flex-grow: 1;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}
.title {
    font-size: 20px;
    margin-bottom: 12px;
}
.description {
    white-space: normal;
    margin-top: 8px;
    margin-bottom: 8px;
}
.controls {
    flex-grow: 1;
    min-height: 120px;
    margin-top: 8px;
}
.actions {
    flex-direction: row;
    flex-wrap: wrap;
}
.actions > Button {
    flex-grow: 1;
}
.control-group {
    margin-top: 8px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}
Button {
    margin-top: 4px;
    margin-bottom: 4px;
}
