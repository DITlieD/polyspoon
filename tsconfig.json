{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["src", "scripts", "tests", "processor/safety", "vite.config.ts"]
}
