{
  "name": "polyspoon-local-foundation",
  "main": "worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "APP_ENV": "local",
    "APP_ORIGIN": "http://127.0.0.1:8793",
    "LOCAL_MAIL_SINK": "1"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "polyspoon-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "../migrations"
  }],
  "r2_buckets": [{"binding": "LOCAL_OBJECTS", "bucket_name": "polyspoon-local-objects"}]
}
