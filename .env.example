# Hosted service (Cloudflare Worker) runtime variables. Names only; set real values as Worker secrets/vars.
APP_ENV=
APP_ORIGIN=
AUTH_SECRET=
RESEND_API_KEY=
MAIL_FROM=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PRIVATE_BUCKET=
PRIVATE_APP_RELEASE=
PUBLIC_FILES=
LOCAL_MAIL_SINK=
# Deploy tooling (scripts/deploy-preflight.ts). The directory holds bindings.json
# ({"account_id","database_id","supabase_url"}) and storage-service-key, both mode 0600.
POLYSPOON_DEPLOY_DIR=
# Cloudflare account and D1 database ids go in bindings.json, never in this repo:
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
D1_DATABASE_ID=REPLACE_ME
